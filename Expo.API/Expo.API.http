@Expo.API_HostAddress = http://localhost:5075

#################################################
# AUTH
#################################################

### Login
POST {{Expo.API_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "admin@expo.com",
  "password": "Admin123!!"
}

# Salva il token in variabile Postman
Tests:
pm.environment.set("token", pm.response.json().token);

#################################################
# USERS
#################################################

### Get all users
GET {{Expo.API_HostAddress}}/api/v1/users
Authorization: Bearer {{token}}
Accept: application/json

### Get user by id
GET {{Expo.API_HostAddress}}/api/v1/users/{{userId}}
Authorization: Bearer {{token}}
Accept: application/json

### Create user
POST {{Expo.API_HostAddress}}/api/v1/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "Password123!",
  "roleName": "User"
}

### Promote user
POST {{Expo.API_HostAddress}}/api/v1/users/{{userId}}/promote
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role": "Admin"
}

### Demote user
POST {{Expo.API_HostAddress}}/api/v1/users/{{userId}}/demote
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role": "User"
}

#################################################
# PAVILIONS
#################################################

### Get all pavilions
GET {{Expo.API_HostAddress}}/api/v1/pavilions
Authorization: Bearer {{token}}
Accept: application/json

### Get pavilion by id
GET {{Expo.API_HostAddress}}/api/v1/pavilions/{{pavilionId}}
Authorization: Bearer {{token}}
Accept: application/json

### Create pavilion
POST {{Expo.API_HostAddress}}/api/v1/pavilions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Pavilion A",
  "area": "North Wing",
  "poweredBy": "Sponsor XYZ",
  "tags": ["tech","expo"]
}

### Update pavilion
PUT {{Expo.API_HostAddress}}/api/v1/pavilions/{{pavilionId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Pavilion A Updated",
  "area": "North Wing",
  "poweredBy": "Sponsor ABC",
  "tags": ["innovation","expo"]
}

### Delete pavilion
DELETE {{Expo.API_HostAddress}}/api/v1/pavilions/{{pavilionId}}
Authorization: Bearer {{token}}

#################################################
# EXHIBITION AREAS
#################################################

### Get all exhibition areas
GET {{Expo.API_HostAddress}}/api/v1/exhibitionareas
Authorization: Bearer {{token}}
Accept: application/json

### Get exhibition area by id
GET {{Expo.API_HostAddress}}/api/v1/exhibitionareas/{{areaId}}
Authorization: Bearer {{token}}
Accept: application/json

### Create exhibition area
POST {{Expo.API_HostAddress}}/api/v1/exhibitionareas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Hall 1",
  "type": "Room",
  "state": "Active",
  "tags": ["ai","vr"]
}

### Update exhibition area
PUT {{Expo.API_HostAddress}}/api/v1/exhibitionareas/{{areaId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Hall 1 Updated",
  "type": "Room",
  "state": "Active",
  "tags": ["ai","innovation"]
}

### Delete exhibition area
DELETE {{Expo.API_HostAddress}}/api/v1/exhibitionareas/{{areaId}}
Authorization: Bearer {{token}}

#################################################
# STANDS
#################################################

### Get all stands
GET {{Expo.API_HostAddress}}/api/v1/stands
Authorization: Bearer {{token}}
Accept: application/json

### Get stand by id
GET {{Expo.API_HostAddress}}/api/v1/stands/{{standId}}
Authorization: Bearer {{token}}
Accept: application/json

### Create stand
POST {{Expo.API_HostAddress}}/api/v1/stands
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Stand 101",
  "width": 3,
  "length": 4,
  "height": 2.5,
  "pavilionId": 1,
  "exhibitionAreaId": 2,
  "tags": ["tech","startup"],
  "categoryIds": [1]
}

### Update stand
PUT {{Expo.API_HostAddress}}/api/v1/stands/{{standId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Stand 101 Updated",
  "width": 3,
  "length": 4,
  "height": 2.5,
  "pavilionId": 1,
  "exhibitionAreaId": 2,
  "tags": ["innovation","expo"],
  "categoryIds": [1]
}

### Delete stand
DELETE {{Expo.API_HostAddress}}/api/v1/stands/{{standId}}
Authorization: Bearer {{token}}

#################################################
# CATEGORIES
#################################################

### Get all categories
GET {{Expo.API_HostAddress}}/api/v1/categories
Authorization: Bearer {{token}}
Accept: application/json

### Get category by id
GET {{Expo.API_HostAddress}}/api/v1/categories/{{categoryId}}
Authorization: Bearer {{token}}
Accept: application/json

### Create category
POST {{Expo.API_HostAddress}}/api/v1/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Robotics",
  "isHighlighted": true,
  "tags": ["tech","future"]
}

### Update category
PUT {{Expo.API_HostAddress}}/api/v1/categories/{{categoryId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Robotics Updated",
  "isHighlighted": true,
  "tags": ["ai","innovation"]
}

### Delete category
DELETE {{Expo.API_HostAddress}}/api/v1/categories/{{categoryId}}
Authorization: Bearer {{token}}